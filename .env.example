# Copy to .env and fill in. Never commit .env.

# --- LLM providers (any one works; the router falls back NVIDIA -> Groq -> Gemini) ---
NVIDIA_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
GEMINI_API_URL=
GEMINI_MODEL=
OPENROUTER_API_KEY=
HF_TOKEN=

# --- Optional overrides ---
# Edge profile the bots sign in with (default: %LOCALAPPDATA%\VeronicaEdgeProfile,
# shared with Veronica so your Naukri/LinkedIn/Indeed logins carry over).
# AUTOJOB_EDGE_PROFILE=
# JOB_AGENT_PROVIDER_ORDER=
# CONTINUOUS_APPLY_MAX=50
# CONTINUOUS_APPLY_DAILY_CAP=50
# HUMAN_CHECK_WAIT_S=300

# --- SaaS web app (saas/) ---
# SAAS_DATABASE_URL=sqlite:///data/saas/autojob.db   (Postgres URL in production)
# SAAS_SECRET_KEY=          signs login cookies (auto-generated into data/saas/ if empty)
# SAAS_FERNET_KEY=          encrypts stored Naukri passwords (auto-generated if empty)
# SAAS_COOKIE_SECURE=1      when served over HTTPS
# SAAS_HEADLESS=1           0 = show the browser while it works
# SAAS_BROWSER_CHANNEL=msedge   empty = Playwright's bundled Chromium (Linux servers)
# SAAS_MAX_PARALLEL_RUNS=2
# SAAS_SCHEDULER_TICK_S=300
# SAAS_DEFAULT_DAILY_LIMIT=25
